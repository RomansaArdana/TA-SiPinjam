# ===== SIPINJAM .gitignore =====

# Konfigurasi lokal
config/database.php

# File sistem
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Dependensi (jika ada)
/vendor/
/node_modules/

# File log
*.log

# File upload user (jika ada)
/uploads/*
!/uploads/.gitkeep

# Abaikan konfigurasi agent/AI
.agents/
AGENTS.md

# Abaikan semua file .md kecuali README.md utama dan AI_USAGE_LOG.md
*.md
!/README.md
!/AI_USAGE_LOG.md

# Wireframe (dokumentasi lokal)
wireframe/
